# LLM provider: mock (default, offline, deterministic) | openai | groq | ollama
AGENTGUARD_PROVIDER=mock
AGENTGUARD_BASE_URL=https://api.openai.com/v1
AGENTGUARD_API_KEY=
AGENTGUARD_MODEL=gpt-4o-mini
# Policy file used by the CLI / guard (YAML or JSON). Defaults to the packaged "default" policy.
AGENTGUARD_POLICY=
# Append-only, hash-chained audit log (JSON Lines)
AGENTGUARD_AUDIT_LOG=agentguard-audit.jsonl

# --- HTTP service (`agentguard serve`) ---
# Comma-separated API keys. When set, every /api call needs X-API-Key or "Authorization: Bearer".
# Without keys the server is a public demo (packaged policies/scenarios, mock provider only).
AGENTGUARD_API_KEYS=
# No auth + full access (inline policies, configured provider). Localhost only!
AGENTGUARD_DEV_MODE=false
# Comma-separated allowed browser origins for CORS (empty = same-origin only)
AGENTGUARD_CORS_ORIGINS=
AGENTGUARD_RATE_LIMIT_PER_MINUTE=120
AGENTGUARD_SCENARIO_LIMIT_PER_MINUTE=20
# Use the right-most X-Forwarded-For hop as client IP (only behind a trusted proxy)
AGENTGUARD_TRUST_PROXY=false
# Optional JSONL file for the server's audit chain (in memory when empty)
AGENTGUARD_SERVER_AUDIT_LOG=
# Optional HMAC key for audit hashes (also used by the CLI)
AGENTGUARD_AUDIT_KEY=
